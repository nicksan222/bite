# Binaries
/bin/
/dist/
/tmp/
*.exe
*.exe~
*.dll
*.so
*.dylib
# /bite (with leading slash) only matches a top-level binary; without it,
# pattern would also match the cmd/bite/ source directory.
/bite

# Test / coverage artifacts
*.test
*.out
coverage.*

# Go workspace
go.work
go.work.sum

# Local env (.env.example is checked in)
.env
.env.local
!.env.example

# SQLite databases
*.db
*.db-journal
*.sqlite
*.sqlite3

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Node (skills.sh runs via npx)
node_modules/

# Local agent harness state — keep the .claude/skills symlink that points
# to .agents/skills so Claude Code finds the same skill set as everyone else.
.claude/*
!.claude/skills
docs/

# Copy to .env and fill in. Loaded automatically on startup.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=

# Optional: SQLite database path. Default: $XDG_DATA_HOME/bite/bite.db
# BITE_DB=./bite.db

# Optional: Claude model id. Default: claude-sonnet-4-6
# BITE_MODEL=claude-haiku-4-5

# Optional: max tokens per turn. Default: 4096
# BITE_MAX_TOKENS=4096

# Optional: override the default nutritionist system prompt.
# BITE_SYSTEM_PROMPT="You are bite. Focus on a 1800 kcal/day cutting plan."

# Copy to .env and fill in. Loaded automatically on startup.

# Pick a provider — the first one whose key is set wins. Leave them all
# blank and bite will offer to install/run Ollama locally on first chat.

# Anthropic Claude (default).
ANTHROPIC_API_KEY=

# OpenAI. Also enables Whisper audio transcription so
# `bite log_meal_from_media note.m4a` works.
# OPENAI_API_KEY=

# Google Gemini.
# GEMINI_API_KEY=

# Force a specific provider regardless of which keys are set:
# anthropic | openai | gemini | ollama
# BITE_PROVIDER=

# Override the local Ollama daemon URL. Default: http://localhost:11434
# OLLAMA_BASE_URL=

# Optional: SQLite database path. Default: $XDG_DATA_HOME/bite/bite.db
# BITE_DB=./bite.db

# Optional: model id. Empty = the active provider's default.
# BITE_MODEL=

# Optional: max tokens per turn. Default: 4096
# BITE_MAX_TOKENS=4096

# Optional: override the default nutritionist system prompt.
# BITE_SYSTEM_PROMPT="You are bite. Focus on a 1800 kcal/day cutting plan."
